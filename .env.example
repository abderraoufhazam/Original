# ============================================================
# OriginalDz — Environment Variables
# ============================================================
# ⚠️ هذا ملف توثيقي فقط — لا يحتوي قيم حقيقية
# ✅ انسخه إلى .env.local للتطوير المحلي
# ✅ أو أضف القيم في Vercel Dashboard → Settings → Environment Variables
# ============================================================

![Tests](https://github.com/abderraoufhazam/Original/actions/workflows/test.yml/badge.svg)

# ─── Supabase ───
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ⚠️ لا تشارك هذا المفتاح أبداً

# ─── تشفير الأكواد ───
ENCRYPTION_KEY=your-secret-key-min-32-chars-long-xxx

# ─── Google Gemini AI ───
GEMINI_API_KEY=AIzaSy...

# ─── Cloudflare Turnstile ───
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ─── Admin Access ───
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ─── CORS (الدومينات المسموحة) ───
ALLOWED_ORIGINS=https://originaldz.online,https://www.originaldz.online

# ─── Green API (WhatsApp) ───
GREEN_API_URL=https://api.green-api.com
GREEN_ID_INSTANCE=1234567890
GREEN_API_TOKEN=xxxxx
WHATSAPP_TO=213xxxxxxxxx

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=random-string

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=xxxxx
VAPID_SUBJECT=mailto:contact@originaldz.online

# ─── Emails ───
BREVO_API_KEY=xkeysib-...
RESEND_API_KEY=re_...
RESEND_FROM=onboarding@resend.dev
EMAILJS_SERVICE_ID=service_xxxxx
EMAILJS_TEMPLATE_VERIFY=template_xxxxx
EMAILJS_PUBLIC_KEY=xxxxx

# ─── Site URL ───
SITE_URL=https://originaldz.online

# ─── Node Environment ───
NODE_ENV=production
